{
  "name": "mgt3745-final",
  "private": true,
  "type": "module",
  "description": "MGT 3745 final: subscription cost tracker built on HW5",
  "scripts": {
    "db:create": "wrangler d1 create mgt3745-entries",
    "db:schema": "wrangler d1 execute mgt3745-entries --remote --file=schema.sql",
    "db:migrate": "wrangler d1 execute mgt3745-entries --remote --file=migrations/0001_add_renewal_date.sql",
    "db:export": "wrangler d1 export mgt3745-entries --remote --output=backup.sql",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"evals/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "4.146.0"
  }
}
